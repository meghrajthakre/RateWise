{
  "manifest_version": 3,
  "name": "RateWise",
  "version": "1.0.0",
  "description": "Compare accommodation prices through your trusted backend.",
  "action": {
    "default_title": "Open RateWise"
  },
  "side_panel": {
    "default_path": "index.html"
  },
  "background": {
    "service_worker": "extension/background.js",
    "type": "module"
  },
  "permissions": ["sidePanel", "tabs", "storage"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["extension/content.js"],
      "run_at": "document_idle"
    }
  ]
}